# Webster frontend environment template
# Copy this file to .env.local.
# Only VITE_* values are exposed to browser code. Do not put private API keys here.

# Nest backend origin used by direct API calls and Vite proxy.
VITE_API=http://localhost:3000

# Browser-facing integration API base. In dev this is proxied by Vite to VITE_API.
VITE_API_BASE_URL=/api
