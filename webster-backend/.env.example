# Webster backend environment template
# Copy this file to .env and fill in real secrets locally.
# Never commit .env.

# Server
PORT=3000
FRONTEND_URL=http://localhost:5173
SESSION_SECRET=replace-with-a-long-random-string

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=webster_db

# Email delivery for registration confirmation and password reset
# Use your SMTP provider credentials locally.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user@example.com
SMTP_PASS=your-smtp-password-or-app-password
FROM_EMAIL=Webster <your-smtp-user@example.com>

# Optional Google OAuth login
# Leave empty if the demo does not use Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# External content APIs used by the backend integration proxy
# Unsplash image search. Public access key is enough for current search usage.
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# Google Fonts list API
GOOGLE_FONTS_API_KEY=

# Iconify SVG search for logo maker icons. No API key required.
ICONIFY_API_BASE_URL=https://api.iconify.design
ICONIFY_PREFIXES=mdi,ph,lucide,tabler,carbon,heroicons,solar

# The Color API palette endpoint. No API key required.
COLOR_API_BASE_URL=https://www.thecolorapi.com
